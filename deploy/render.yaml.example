# Offline template only. Copy to repository root after deployment authorization.
# Current repository root is Pok-Mota, so no rootDir is needed.
services:
  - type: web
    name: collector-store-web
    runtime: node
    plan: 0.5c-512mb
    region: frankfurt # provisional; confirm region before creating resources
    numInstances: 1
    autoDeployTrigger: "off"
    buildCommand: npm ci --omit=dev
    startCommand: npm start
    healthCheckPath: /api/health
    maxShutdownDelaySeconds: 30
    envVars:
      - key: NODE_VERSION
        value: "24"
      - key: NODE_ENV
        value: production
      - key: PUBLIC_ORIGIN
        sync: false
      - key: DATABASE_URL # external TLS URI with dedicated runtime role; see OPERATIONS.md
        sync: false
      - key: DATABASE_SSL
        value: "true"
      - key: TRUST_PROXY # confirm the trusted proxy topology before using this
        value: "1"
      - key: ADMIN_USERNAME
        sync: false
      - key: ADMIN_PASSWORD_HASH
        sync: false
      - key: ADMIN_TOTP_SECRET
        sync: false
      - key: ADMIN_TOTP_ENABLED
        value: "true"
      - key: SUPPORT_EMAIL
        sync: false
      - key: STORE_NAME
        sync: false
      - key: PAYMENT_MODE
        value: sandbox
      - key: PAYSTACK_SECRET_KEY
        sync: false
      - key: PAYSTACK_LIVE_READY
        value: "false"
      - key: CHECKOUT_ENABLED
        value: "false"
      - key: POLICIES_APPROVED
        value: "false"
      - key: EFT_ORDER_EXPIRY_HOURS
        value: "0"
databases:
  - name: collector-store-db
    plan: 0.1c-256mb
    region: frankfurt
    postgresMajorVersion: "18"
    diskSizeGB: 1
    ipAllowList: [] # closed initially; allow only web-service outbound CIDRs for external verified TLS
# No automatic owner URL injection or pre-deploy migration with owner secrets.
# Run migrations from a separate protected operator/CI environment first.
