{
  "name": "pokemota",
  "version": "0.2.0",
  "private": true,
  "description": "PokéMota storefront and local admin inventory API",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "db:init": "node server/init-db.js",
    "test": "node --test tests/*.test.js",
    "db:runtime": "node server/provision-runtime.js",
    "ops:maintenance": "node server/maintenance.js",
    "backup": "node server/backup.js",
    "backup:drill": "node server/restore-drill.js",
    "account:recovery": "node server/issue-recovery.js",
    "ops:retention": "node server/data-retention.js",
    "admin:mfa-setup": "node server/setup-admin-mfa.js",
    "ops:monitor": "node server/monitor.js",
    "admin:recover": "node server/recover-admin.js"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "dotenv": "^16.4.7",
    "helmet": "^8.0.0",
    "cookie": "^0.7.2",
    "express-rate-limit": "^7.5.0"
  }
}
