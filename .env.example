PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pokemota
ADMIN_USERNAME=admin
# Generate a long random password; never commit your real .env
# Development-only fallback (production requires ADMIN_PASSWORD_HASH):
# ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_PASSWORD_HASH=
# salted scrypt format: 32 hex salt + colon + 128 hex digest (see LAUNCH-REVIEW.md)
# Required in production: set to your deployed HTTPS origin, e.g. https://shop.example.com
# PUBLIC_ORIGIN=
# Render uses RENDER_EXTERNAL_URL automatically when PUBLIC_ORIGIN is unset.
# Set PUBLIC_ORIGIN explicitly when connecting pokemota.hassanmansoor.co.za.
NODE_ENV=development

# Online payments are hidden unless PUBLIC_ORIGIN and required credentials are set.
# Use your exact origin without a trailing slash. Public HTTPS is needed for webhooks.
# PUBLIC_ORIGIN=https://your-store.example
# PayFast: configure a matching passphrase in the merchant dashboard.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
# Paystack: use test credentials until the full checkout/webhook flow is verified.
PAYSTACK_SECRET_KEY=
# Stripe requires an eligible Stripe merchant account (Paystack uses separate keys).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Enable certificate-verified database TLS on the production connection.
DATABASE_SSL=false
# Set 1 only behind exactly one trusted reverse proxy.
TRUST_PROXY=0
# Temporary store name used in gateway payment descriptions.
STORE_NAME=Pok?Mota

SUPPORT_EMAIL=
# sandbox requires sk_test_ keys. Live mode requires sandbox sign-off.
PAYMENT_MODE=sandbox
PAYSTACK_LIVE_READY=false
# Production checkout stays closed until explicitly enabled and policies approved.
CHECKOUT_ENABLED=false
POLICIES_APPROVED=false
# Disabled until the owner approves a published EFT payment deadline.
EFT_ORDER_EXPIRY_HOURS=0
# 32 random bytes as 64 hex characters; keep a separate recovery copy.
BACKUP_ENCRYPTION_KEY=
# PostgreSQL client tools must match the server major version.
# PG_BIN=C:/Program Files/PostgreSQL/14/bin
# For libpq certificate verification, provide the provider CA root if required.
# PGSSLROOTCERT=/protected/path/provider-ca.pem

# Optional provider CA PEM for Node certificate verification (never disable verification).
DATABASE_CA_CERT=
ADMIN_TOTP_ENABLED=false
ADMIN_TOTP_SECRET=
# Unset until POLICY-DRAFTS.md is approved. No deletion occurs by default.
RETENTION_ORDER_DAYS=
RETENTION_ACCOUNT_DAYS=
